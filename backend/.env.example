# Copy to backend/.env for local runs. On Render, set these in the dashboard instead.
# NEVER commit a real .env — this file is a template only.

# --- Login for website + mobile app (fixed here, not in code) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Random string; signs login tokens so they survive redeploys. e.g. `openssl rand -hex 32`
SESSION_SECRET=
SESSION_TTL_HOURS=24

# --- Telegram control (bot token from @BotFather, your numeric id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Database (for Render: set via fromDatabase in render.yaml; for local Docker use compose) ---
# Local Postgres: DATABASE_URL=postgresql://predagent:postgres@localhost:5432/predagent
# Leave blank to use SQLite in-memory (development only — data not persisted across restart).
DATABASE_URL=

# --- Trading (PAPER by default; NEVER set LIVE_TRADING=true without completing live checklist) ---
LIVE_TRADING=false
PRIVATE_KEY=
# REQUIRED for ordinary JWT login (X-API-Key on login-with-signature) and for the balance/wallet view.
# Without it the app shows "Not configured" instead of a balance. Not the CLOB partner key below.
PRED_API_KEY=
# PRED-issued Builder/Aggregator partner key (X-Aggregator-API-Key). Leave blank unless PRED gave you one.
# Only used to create a NEW CLOB account when PRED refuses your EOA (uses 1 account-creation unit, new Safe).
PRED_PARTNER_KEY=

# --- LLM (any OpenAI-compatible provider: OpenAI, OpenRouter, DeepSeek, Groq, local...) ---
# IMPORTANT: choose a model that supports tool-calling / function-calling for best results.
# Tested models: gpt-4o-mini, gpt-4o, deepseek-chat, claude-3-5-haiku.
# The LLM is used for research/probability only; it has NO approve/execute/trade tool.
LLM_API_KEY=
LLM_MODEL=
# Must end at the API root (the app adds /chat/completions). Default: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# --- Chain (optional — only needed for on-chain verification / Safe approval) ---
BASE_RPC_URL=
